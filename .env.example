# Local Clerk development instance. Public browser key only uses VITE_.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
# Optional local alternative to JWT public-key verification.
CLERK_SECRET_KEY=
# Normally derived from the publishable key.
CLERK_ISSUER=
# Local overrides (defaults: both localhost origins on port 5174).
# ACCOUNTS_ORIGIN=http://localhost:5174
# ACCOUNTS_DATABASE=.data/accounts.sqlite

# Deployment credentials stay outside Git. Never prefix secrets with VITE_.
CLOUDFLARE_API_TOKEN=
# Set once a custom domain has been chosen.
ACADEMY_HOSTNAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
