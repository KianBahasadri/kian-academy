{
  "name": "kian-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "build:cloudflare": "npm run build && npm run build:worker",
    "build:worker": "tsc -p tsconfig.cloudflare.json && node scripts/build-cloudflare.mjs",
    "test:accounts": "node --experimental-strip-types --test tests/server/*.test.ts",
    "test:cloudflare": "npm run build:worker && node --experimental-strip-types --test tests/cloudflare/*.test.ts",
    "infra": "node scripts/terraform.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.3",
    "@clerk/react": "^6.18.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.0-beta",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
